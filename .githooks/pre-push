#!/usr/bin/env bash
# pre-push —— push 前跑全量冒烟（约 2min），坏提交不进 main
# 启用：git config core.hooksPath .githooks   （首次 clone 后执行一次）
# 绕过：AGORA_SKIP_SMOKE=1 git push ...
set -euo pipefail
[[ "${AGORA_SKIP_SMOKE:-}" == "1" ]] && exit 0
ROOT="$(git rev-parse --show-toplevel)"
echo "[pre-push] 跑 smoke-test（约 2min，AGORA_SKIP_SMOKE=1 可跳过）..."
if ! (cd "$ROOT" && bash tests/smoke-test.sh) > "${TMPDIR:-/tmp}/agora-mcp-prepush.log" 2>&1; then
  echo "[pre-push] smoke 未过，拒绝 push——末尾日志：" >&2
  tail -8 "${TMPDIR:-/tmp}/agora-mcp-prepush.log" >&2
  exit 1
fi
echo "[pre-push] smoke 全绿"
